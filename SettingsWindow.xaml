<Window x:Class="DynamicIslandWin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Island Settings"
        Height="490" Width="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- 侧边导航按键样式 -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#15FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 调色圆球样式（描边/厚度可编程，用于“当前选中”加深高亮） -->
        <Style x:Key="ColorCircleStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#50FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 1. 定制纯暗黑流体 Slider（整轨可点、点击即定位，拖动跟手） -->
        <Style x:Key="ModernDarkSlider" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Margin="0,4">
                            <Border Height="4" CornerRadius="2" Background="#25FFFFFF"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#00E5FF"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#25FFFFFF"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="16" Height="16" CornerRadius="8" Background="White" Cursor="Hand">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#00E5FF" Opacity="0.8"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. 定制纯暗黑 ComboBoxItem 样式 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2500E5FF"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#3500E5FF"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. 定制纯暗黑流体 ComboBox 样式 -->
        <Style x:Key="ModernActionCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="136"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="b" Background="#20FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0 Z" Fill="#88FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#30FFFFFF"/>
                                                <Setter TargetName="b" Property="BorderBrush" Value="#60FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" Margin="10,0,24,0"/>

                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDown" Background="#F418181C" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="190" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.7" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. 定制纯暗黑流体 CheckBox 样式 -->
        <Style x:Key="ModernDarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="boxBorder" Width="16" Height="16" CornerRadius="5" Background="#20FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" Margin="0,0,8,0">
                                <Path x:Name="checkMark" Data="M 3,8 L 6,11 L 13,4" Stroke="#00E5FF" StrokeThickness="2" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="boxBorder" Property="Background" Value="#2500E5FF"/>
                                <Setter TargetName="boxBorder" Property="BorderBrush" Value="#8000E5FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="boxBorder" Property="BorderBrush" Value="#80FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 5. 定制纯暗黑流体 RadioButton 样式 -->
        <Style x:Key="ModernDarkRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="radioBorder" Width="16" Height="16" CornerRadius="8" Background="#20FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" Margin="0,0,6,0">
                                <Ellipse x:Name="radioDot" Width="8" Height="8" Fill="#00E5FF" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="radioDot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="radioBorder" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter TargetName="radioBorder" Property="Background" Value="#2500E5FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="radioBorder" Property="BorderBrush" Value="#80FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 主外壳容器 -->
    <Border x:Name="SettingsRootBorder" Background="#F2141416" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="20" Margin="10"
            MouseLeftButtonDown="Border_MouseLeftButtonDown"
            RenderTransformOrigin="0.5, 0.1">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="SettingsScale" ScaleX="0.88" ScaleY="0.88"/>
                <TranslateTransform x:Name="SettingsTranslate" Y="-15"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.7" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 顶栏 -->
                <RowDefinition Height="*"/>    <!-- 分栏主体 -->
                <RowDefinition Height="Auto"/> <!-- 底栏 -->
            </Grid.RowDefinitions>

            <!-- 1. 顶栏 -->
            <Grid Grid.Row="0" Margin="20,16,20,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✦" Foreground="#00E5FF" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="灵动岛控制中心 (可按住拖拽)" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right" Foreground="#66FFFFFF" Background="Transparent" BorderThickness="0" FontSize="13" Cursor="Hand"/>
            </Grid>

            <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1" Fill="#15FFFFFF" Margin="16,0"/>

            <!-- 2. 分栏主体 -->
            <Grid Grid.Row="1" Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航 -->
                <StackPanel Grid.Column="0" Margin="0,4,10,0">
                    <Button x:Name="NavThemes" Content="🎨  质感材质" Click="NavThemes_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="NavBasic" Content="⚙️  基本偏好" Click="NavBasic_Click" Style="{StaticResource NavButtonStyle}" Background="#25FFFFFF" Foreground="White"/>
                    <Button x:Name="NavArchitecture" Content="🚀  胶囊交互设置" Click="NavArchitecture_Click" Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="#15FFFFFF" Margin="0,4"/>

                <!-- 右侧功能区 -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="16,0,4,0">
                    <Grid>
                        <!-- 面板 A: 质感材质 -->
                        <StackPanel x:Name="PanelThemes" Visibility="Collapsed">
                            <TextBlock Text="选择整体流体质感主题" Foreground="#77FFFFFF" FontSize="11" Margin="2,0,0,10"/>
                            <Button Click="ThemeSelect_Click" Tag="AeroLight" Background="#14FFFFFF" BorderThickness="0" Margin="0,3" Padding="10,7" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="16" Height="16" CornerRadius="8" Background="#EFEFF5" BorderBrush="#80FFFFFF" BorderThickness="1" Margin="0,0,12,0"/>
                                    <TextBlock Text="高透亮白 (Aero Light - 清透高光)" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Click="ThemeSelect_Click" Tag="AeroDark" Background="#14FFFFFF" BorderThickness="0" Margin="0,3" Padding="10,7" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="16" Height="16" CornerRadius="8" Background="#D5121216" BorderBrush="#B0FFFFFF" BorderThickness="1" Margin="0,0,12,0"/>
                                    <TextBlock Text="高透暗色 (Aero Dark - 暗色高透)" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- 面板 B: 基本偏好 -->
                        <StackPanel x:Name="PanelBasic" Visibility="Visible">
                            <!-- 0. 闲置样式（置于基本偏好最顶部，方便查找） -->
                            <Border Background="#14FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="闲置样式" Foreground="#E0FFFFFF" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <RadioButton x:Name="RadioIdleNone" GroupName="IdleStyleGroup" Content="无（闲置不变化）" Tag="0"
                                                 Click="OnIdleStyleRadioChanged" Style="{StaticResource ModernDarkRadioButton}"/>
                                    <RadioButton x:Name="RadioIdleCircle" GroupName="IdleStyleGroup" Content="灵动小圆点（原地）" Tag="1"
                                                 Click="OnIdleStyleRadioChanged" Style="{StaticResource ModernDarkRadioButton}" Margin="0,3,0,0"/>
                                    <RadioButton x:Name="RadioIdleNotch" GroupName="IdleStyleGroup" Content="刘海吸附（吸顶药丸）· Beta" Tag="2"
                                                 Click="OnIdleStyleRadioChanged" Style="{StaticResource ModernDarkRadioButton}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 1. 全局缩放比例 -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="胶囊全局缩放比例 (UI Scale)" Foreground="#99FFFFFF" FontSize="12"/>
                                <TextBlock x:Name="TxtCapsuleScaleVal" Text="100 %" Foreground="#00E5FF" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderCapsuleScale" Style="{StaticResource ModernDarkSlider}"
                                    Minimum="0.80" Maximum="1.40" Value="1.0" SmallChange="0.05" LargeChange="0.1" ValueChanged="SliderCapsuleScale_ValueChanged" Margin="0,2,0,8"/>

                            <!-- 2. 宽度与自适应 -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="胶囊基准宽度" Foreground="#99FFFFFF" FontSize="12"/>
                                <TextBlock x:Name="TxtCapsuleWidthVal" Text="280 px" Foreground="#00E5FF" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderCapsuleWidth" Style="{StaticResource ModernDarkSlider}"
                                    Minimum="220" Maximum="480" Value="280" ValueChanged="SliderCapsuleWidth_ValueChanged" Margin="0,2,0,8"/>

                            <!-- 3. 声波条数自定义 -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="律动声波条数 (3 ~ 9 根)" Foreground="#99FFFFFF" FontSize="12"/>
                                <TextBlock x:Name="TxtWaveCountVal" Text="5 根" Foreground="#00E5FF" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderWaveCount" Style="{StaticResource ModernDarkSlider}"
                                    Minimum="3" Maximum="9" Value="5" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" ValueChanged="SliderWaveCount_ValueChanged" Margin="0,2,0,8"/>

                            <!-- 4. 声波最大高度自定义 -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="律动声波最大跳跃高度" Foreground="#99FFFFFF" FontSize="12"/>
                                <TextBlock x:Name="TxtWaveHeightVal" Text="24 px" Foreground="#00E5FF" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderWaveMaxHeight" Style="{StaticResource ModernDarkSlider}"
                                    Minimum="12" Maximum="32" Value="24" ValueChanged="SliderWaveMaxHeight_ValueChanged" Margin="0,2,0,8"/>

                            <Border Background="#14FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                                <CheckBox x:Name="ChkAutoWidth" Content="启用曲名内容自适应宽度 (随文字流体调节)" Click="ChkAutoWidth_Click"
                                          Style="{StaticResource ModernDarkCheckBox}" FontWeight="SemiBold" FontSize="12" IsChecked="True"/>
                            </Border>

                            <TextBlock Text="律动声波拾色球" Foreground="#99FFFFFF" FontSize="11" Margin="0,0,0,6"/>
                            <StackPanel x:Name="WaveColorsRow" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Click="WaveColor_Click" Tag="#00E5FF" Background="#00E5FF" Style="{StaticResource ColorCircleStyle}"/>
                                <Button Click="WaveColor_Click" Tag="#BF5AF2" Background="#BF5AF2" Style="{StaticResource ColorCircleStyle}"/>
                                <Button Click="WaveColor_Click" Tag="#30D158" Background="#30D158" Style="{StaticResource ColorCircleStyle}"/>
                                <Button Click="WaveColor_Click" Tag="#FF9F0A" Background="#FF9F0A" Style="{StaticResource ColorCircleStyle}"/>
                                <Button Click="WaveColor_Click" Tag="#FFFFFF" Background="#FFFFFF" Style="{StaticResource ColorCircleStyle}"/>
                            </StackPanel>

                            <TextBlock Text="字体颜色（胶囊文字主色，可随主题或自定义）" Foreground="#99FFFFFF" FontSize="11" Margin="0,0,0,6"/>
                            <StackPanel x:Name="FontColorsRow" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Click="FontColor_Click" Tag="Auto" Background="#20FFFFFF" BorderBrush="#60FFFFFF" BorderThickness="1" Content="随主题" Foreground="#B0FFFFFF" FontSize="10" Height="26" Padding="8,0" Margin="0,0,10,0" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="13"/></Style></Button.Resources>
                                </Button>
                                <Button Click="FontColor_Click" Tag="#FFFFFF" Background="#FFFFFF" Style="{StaticResource ColorCircleStyle}"/>
                                <Button Click="FontColor_Click" Tag="#E6E9EF" Background="#E6E9EF" Style="{StaticResource ColorCircleStyle}"/>
                                <Button Click="FontColor_Click" Tag="#00E5FF" Background="#00E5FF" Style="{StaticResource ColorCircleStyle}"/>
                                <Button Click="FontColor_Click" Tag="#5AC8FA" Background="#5AC8FA" Style="{StaticResource ColorCircleStyle}"/>
                                <Button Click="FontColor_Click" Tag="#BF5AF2" Background="#BF5AF2" Style="{StaticResource ColorCircleStyle}"/>
                                <Button Click="FontColor_Click" Tag="#101418" Background="#101418" BorderBrush="#50FFFFFF" BorderThickness="1" Style="{StaticResource ColorCircleStyle}"/>
                            </StackPanel>

                            <Border Background="#14FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
                                <CheckBox x:Name="ChkStartup" Content="开机自启 (跟随 Windows 自动载入)" Click="ChkStartup_Click"
                                          Style="{StaticResource ModernDarkCheckBox}" FontSize="12"/>
                            </Border>

                            <Button Content="🔄  瞬间重置居中位置" Click="ResetPos_Click"
                                    Background="#20FFFFFF" Foreground="White" BorderBrush="#30FFFFFF" BorderThickness="1"
                                    Height="30" Padding="16,0" HorizontalAlignment="Left" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>

                            <!-- 检查更新 -->
                            <Border Background="#14FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,10,0,0">
                                <StackPanel>
                                    <CheckBox x:Name="ChkAutoCheckUpdate" Content="启动时静默检查更新（有新版本才提示）" Click="ChkAutoCheckUpdate_Click"
                                              Style="{StaticResource ModernDarkCheckBox}" FontSize="12"/>
                                    <TextBlock Text="更新清单地址 (version.json：{ version, note, url })" Foreground="#99FFFFFF" FontSize="10" Margin="0,6,0,3"/>
                                    <TextBox x:Name="TxtUpdateManifestUrl" TextChanged="TxtUpdateManifestUrl_TextChanged"
                                             Background="#20FFFFFF" Foreground="White" BorderBrush="#35FFFFFF" BorderThickness="1"
                                             Padding="8,4" FontSize="11" Height="28" VerticalContentAlignment="Center"
                                             ToolTip="填入能下载到的 version.json 的完整地址">
                                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                                    </TextBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 面板 C: 胶囊架构与专属动作配置 -->
                        <StackPanel x:Name="PanelArchitecture" Visibility="Collapsed">
                            <TextBlock Text="胶囊架构与专属点击/右键交互配置" Foreground="#99FFFFFF" FontSize="11" Margin="2,0,0,8"/>

                            <!-- 卡片 1: 媒体播放器 -->
                            <Border x:Name="CardMedia" Background="#14FFFFFF" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtTitleMedia" Grid.Column="0" Text="🎵  媒体播放器" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <RadioButton x:Name="RadioMainMedia" Grid.Column="2" GroupName="MainCapsuleGroup" Content="设为主胶囊" Click="OnMainCapsuleRadioChanged" Style="{StaticResource ModernDarkRadioButton}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnRemoveMedia" Grid.Column="3" Content="✕ 移除" Tag="Media" Click="RemoveCapsule_Click"
                                                Background="#22FF453A" Foreground="#FF9F9F" BorderThickness="0" Padding="10,0" Height="24" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </Grid>
                                    <Grid Background="#10FFFFFF" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="6,4">
                                            <TextBlock Text="左键: " Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbMediaLeftAction" SelectionChanged="CmbMediaAction_SelectionChanged" Style="{StaticResource ModernActionCombo}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,4" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblMediaRight" Text="右键: " Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbMediaRightAction" SelectionChanged="CmbMediaAction_SelectionChanged" Style="{StaticResource ModernActionCombo}"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- 任一侧选择“🚀 打开自定义程序”时在此展开：本胶囊专属程序选择器 -->
                                    <Border x:Name="MediaCustomAppRow" Visibility="Collapsed" Background="#10FFFFFF" CornerRadius="10" Padding="8,6" Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🚀 自定义程序:" Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                            <TextBox x:Name="TxtMediaCustomApp" Tag="Media" Grid.Column="1" TextChanged="TxtCustomAppPath_TextChanged"
                                                     Background="#20FFFFFF" Foreground="White" BorderBrush="#35FFFFFF" BorderThickness="1"
                                                     Padding="8,3" FontSize="11" Height="26" VerticalContentAlignment="Center">
                                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                                            </TextBox>
                                            <Button Content="📁 浏览..." Tag="Media" Click="BtnBrowseApp_Click" Grid.Column="2"
                                                    Background="#25FFFFFF" Foreground="White" BorderThickness="0"
                                                    Padding="10,0" Height="26" Margin="6,0,0,0" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="✕ 清除" Tag="Media" Click="ClearCustomApp_Click" Grid.Column="3"
                                                    Background="#18FFFFFF" Foreground="#B0FFFFFF" BorderThickness="0"
                                                    Padding="8,0" Height="26" Margin="6,0,0,0" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <!-- ♥ 喜欢按键（鼠标宏式：点按 ♥ 后执行下方按键） -->
                                    <Border Background="#10FFFFFF" CornerRadius="10" Padding="8,6" Margin="0,6,0,0">
                                        <StackPanel>
                                            <CheckBox x:Name="ChkLikeShortcut" Content="❤ 启用“喜欢”按键（展开卡显示 ♥）" Click="ChkLikeShortcut_Click"
                                                      Style="{StaticResource ModernDarkCheckBox}" FontWeight="SemiBold" FontSize="12"/>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="点按 ♥ 后执行的按键:" Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox x:Name="TxtLikeKey" Grid.Column="1" Text="F5" Height="24" Padding="6,2" FontSize="11"
                                                         VerticalContentAlignment="Center" Background="#20FFFFFF" Foreground="White"
                                                         BorderBrush="#35FFFFFF" BorderThickness="1"
                                                         ToolTip="例：F5、F6、Ctrl+F5、Ctrl+J —— 你的音乐软件里绑定“喜欢”的键"
                                                         LostKeyboardFocus="LikeField_LostFocus" KeyDown="LikeField_KeyDown">
                                                    <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                                                </TextBox>
                                            </Grid>
                                            <TextBlock Text="小提醒：点按 ♥ 后会自动把上方按键发送给前台播放器（如同鼠标宏自动按键）；修改后回车或点击别处生效，格式非法会原样退回。请先在音乐软件里把该键绑定为「喜欢」——不同软件默认键不同，不生效就换一个试试，使用前让播放器处于前台窗口。"
                                                       Foreground="#55FFFFFF" FontSize="10" Margin="2,6,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 卡片 2: 通知与时钟 -->
                            <Border x:Name="CardNotif" Background="#14FFFFFF" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtTitleNotif" Grid.Column="0" Text="💬  通知与时钟" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <RadioButton x:Name="RadioMainNotif" Grid.Column="2" GroupName="MainCapsuleGroup" Content="设为主胶囊" Click="OnMainCapsuleRadioChanged" Style="{StaticResource ModernDarkRadioButton}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnRemoveNotif" Grid.Column="3" Content="✕ 移除" Tag="Notification" Click="RemoveCapsule_Click"
                                                Background="#22FF453A" Foreground="#FF9F9F" BorderThickness="0" Padding="10,0" Height="24" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </Grid>
                                    <Grid Background="#10FFFFFF" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="6,4">
                                            <TextBlock Text="左键: " Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbNotifLeftAction" SelectionChanged="CmbNotifAction_SelectionChanged" Style="{StaticResource ModernActionCombo}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,4">
                                            <TextBlock x:Name="LblNotifRight" Text="右键: " Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbNotifRightAction" SelectionChanged="CmbNotifAction_SelectionChanged" Style="{StaticResource ModernActionCombo}"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- 任一侧选择“🚀 打开自定义程序”时在此展开：本胶囊专属程序选择器 -->
                                    <Border x:Name="NotifCustomAppRow" Visibility="Collapsed" Background="#10FFFFFF" CornerRadius="10" Padding="8,6" Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🚀 自定义程序:" Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                            <TextBox x:Name="TxtNotifCustomApp" Tag="Notification" Grid.Column="1" TextChanged="TxtCustomAppPath_TextChanged"
                                                     Background="#20FFFFFF" Foreground="White" BorderBrush="#35FFFFFF" BorderThickness="1"
                                                     Padding="8,3" FontSize="11" Height="26" VerticalContentAlignment="Center">
                                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                                            </TextBox>
                                            <Button Content="📁 浏览..." Tag="Notification" Click="BtnBrowseApp_Click" Grid.Column="2"
                                                    Background="#25FFFFFF" Foreground="White" BorderThickness="0"
                                                    Padding="10,0" Height="26" Margin="6,0,0,0" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="✕ 清除" Tag="Notification" Click="ClearCustomApp_Click" Grid.Column="3"
                                                    Background="#18FFFFFF" Foreground="#B0FFFFFF" BorderThickness="0"
                                                    Padding="8,0" Height="26" Margin="6,0,0,0" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <!-- ⏰ 定时提醒：每天在设定时刻触发一次通知 -->
                                    <Border Background="#10FFFFFF" CornerRadius="10" Padding="8,6" Margin="0,6,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="⏰ 定时提醒（每天在设定时间提醒一次）" Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                                <Button Content="＋ 添加提醒" Click="AddReminder_Click" HorizontalAlignment="Right"
                                                        Background="#2000E5FF" Foreground="#00E5FF" BorderThickness="0" Padding="10,0" Height="24" Cursor="Hand">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                </Button>
                                            </Grid>
                                            <StackPanel x:Name="RemindersList" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 卡片 3: 硬件监控 -->
                            <Border x:Name="CardHw" Background="#14FFFFFF" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtTitleHw" Grid.Column="0" Text="📊  硬件监控 (CPU/GPU)" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <RadioButton x:Name="RadioMainHw" Grid.Column="2" GroupName="MainCapsuleGroup" Content="设为主胶囊" Click="OnMainCapsuleRadioChanged" Style="{StaticResource ModernDarkRadioButton}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnRemoveHw" Grid.Column="3" Content="✕ 移除" Tag="Hardware" Click="RemoveCapsule_Click"
                                                Background="#22FF453A" Foreground="#FF9F9F" BorderThickness="0" Padding="10,0" Height="24" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </Grid>
                                    <Grid Background="#10FFFFFF" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="6,4">
                                            <TextBlock Text="左键: " Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbHwLeftAction" SelectionChanged="CmbHwAction_SelectionChanged" Style="{StaticResource ModernActionCombo}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,4">
                                            <TextBlock x:Name="LblHwRight" Text="右键: " Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbHwRightAction" SelectionChanged="CmbHwAction_SelectionChanged" Style="{StaticResource ModernActionCombo}"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- 任一侧选择“🚀 打开自定义程序”时在此展开：本胶囊专属程序选择器 -->
                                    <Border x:Name="HwCustomAppRow" Visibility="Collapsed" Background="#10FFFFFF" CornerRadius="10" Padding="8,6" Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🚀 自定义程序:" Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                            <TextBox x:Name="TxtHwCustomApp" Tag="Hardware" Grid.Column="1" TextChanged="TxtCustomAppPath_TextChanged"
                                                     Background="#20FFFFFF" Foreground="White" BorderBrush="#35FFFFFF" BorderThickness="1"
                                                     Padding="8,3" FontSize="11" Height="26" VerticalContentAlignment="Center">
                                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                                            </TextBox>
                                            <Button Content="📁 浏览..." Tag="Hardware" Click="BtnBrowseApp_Click" Grid.Column="2"
                                                    Background="#25FFFFFF" Foreground="White" BorderThickness="0"
                                                    Padding="10,0" Height="26" Margin="6,0,0,0" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="✕ 清除" Tag="Hardware" Click="ClearCustomApp_Click" Grid.Column="3"
                                                    Background="#18FFFFFF" Foreground="#B0FFFFFF" BorderThickness="0"
                                                    Padding="8,0" Height="26" Margin="6,0,0,0" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 卡片 4: 记事备忘（可添加预设胶囊：展示文字） -->
                            <Border x:Name="CardNote" Background="#14FFFFFF" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtTitleNote" Grid.Column="0" Text="📝  记事备忘 (自定义文字胶囊)" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <RadioButton x:Name="RadioMainNote" Grid.Column="2" GroupName="MainCapsuleGroup" Content="设为主胶囊" Click="OnMainCapsuleRadioChanged" Style="{StaticResource ModernDarkRadioButton}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnRemoveNote" Grid.Column="3" Content="✕ 移除" Tag="Note" Click="RemoveCapsule_Click"
                                                Background="#22FF453A" Foreground="#FF9F9F" BorderThickness="0" Padding="10,0" Height="24" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </Grid>
                                    <TextBox x:Name="TxtNoteTitle" TextChanged="TxtNoteTitle_TextChanged"
                                             Background="#20FFFFFF" Foreground="White" BorderBrush="#35FFFFFF" BorderThickness="1"
                                             Padding="8,5" FontSize="11" FontWeight="SemiBold" Height="30"
                                             VerticalContentAlignment="Center"
                                             ToolTip="在此输入备忘标题：闲置/紧凑态胶囊与展开态均显示该标题">
                                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                                    </TextBox>
                                    <TextBox x:Name="TxtNoteContent" TextChanged="TxtNoteContent_TextChanged"
                                             Background="#20FFFFFF" Foreground="White" BorderBrush="#35FFFFFF" BorderThickness="1"
                                             Padding="8,5" FontSize="11" Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                             ToolTip="在此输入备忘内容：胶囊悬停/点击展开即可展示这段文字">
                                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                                    </TextBox>
                                    <Grid Background="#10FFFFFF" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="6,4">
                                            <TextBlock Text="左键: " Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbNoteLeftAction" SelectionChanged="CmbNoteAction_SelectionChanged" Style="{StaticResource ModernActionCombo}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,4">
                                            <TextBlock x:Name="LblNoteRight" Text="右键: " Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CmbNoteRightAction" SelectionChanged="CmbNoteAction_SelectionChanged" Style="{StaticResource ModernActionCombo}"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- 任一侧选择“🚀 打开自定义程序”时展开：备忘胶囊专属程序选择器 -->
                                    <Border x:Name="NoteCustomAppRow" Visibility="Collapsed" Background="#10FFFFFF" CornerRadius="10" Padding="8,6" Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🚀 自定义程序:" Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                            <TextBox x:Name="TxtNoteCustomApp" Tag="Note" Grid.Column="1" TextChanged="TxtCustomAppPath_TextChanged"
                                                     Background="#20FFFFFF" Foreground="White" BorderBrush="#35FFFFFF" BorderThickness="1"
                                                     Padding="8,3" FontSize="11" Height="26" VerticalContentAlignment="Center">
                                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                                            </TextBox>
                                            <Button Content="📁 浏览..." Tag="Note" Click="BtnBrowseApp_Click" Grid.Column="2"
                                                    Background="#25FFFFFF" Foreground="White" BorderThickness="0"
                                                    Padding="10,0" Height="26" Margin="6,0,0,0" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="✕ 清除" Tag="Note" Click="ClearCustomApp_Click" Grid.Column="3"
                                                    Background="#18FFFFFF" Foreground="#B0FFFFFF" BorderThickness="0"
                                                    Padding="8,0" Height="26" Margin="6,0,0,0" Cursor="Hand">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- ➕ 可用预设胶囊库（从 plugins 目录动态扫描，点击添加/切换） -->
                            <Border x:Name="PresetLibrary" Background="#10FFFFFF" CornerRadius="12" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="➕ 可用预设胶囊（来自 plugins 插件目录，点击添加）" Foreground="#88FFFFFF" FontSize="11" Margin="2,0,0,4"/>
                                    <StackPanel x:Name="PluginsLibraryList" Margin="0,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- 3. 底栏 -->
            <Grid Grid.Row="2" Margin="20,8,20,16">
                <TextBlock x:Name="VersionLabel" Text="DynamicIslandWin" Foreground="#55FFFFFF" FontSize="10" VerticalAlignment="Center"/>
                <Button Content="❌ 退出灵动岛" Click="ExitApp_Click" HorizontalAlignment="Right" Background="#25FF453A" Foreground="#FF453A" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Height="30" Padding="16,0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>